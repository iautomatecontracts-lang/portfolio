# --- Auth0 ---
AUTH0_DOMAIN=your-tenant.us.auth0.com
# Machine-to-machine app authorized for the Management API with read:logs.
# Add update:users, delete:sessions, delete:refresh_tokens only if AUTO_RESPONSE != none.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Authorization header value you set on the Auth0 Log Stream (custom webhook)
AUTH0_LOG_STREAM_SECRET=

# --- Claude triage ---
ANTHROPIC_API_KEY=
CLAUDE_TRIAGE=true
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# --- Detection tuning ---
TRIAGE_THRESHOLD=0.35            # heuristic score that sends an event to Claude
FLAG_THRESHOLD=0.6               # heuristic score that alerts when Claude is off/unavailable
WINDOW_SECONDS=900
ALLOWLIST=terraform@example.com,tfDeployClient   # sanctioned automation: user_id, email or client_id

# --- Alerting / response ---
SLACK_WEBHOOK_URL=
AUTO_RESPONSE=none               # none | revoke_sessions | block
AUTO_RESPONSE_MIN_CONFIDENCE=0.9
