# --- Okta ---
OKTA_ORG_URL=https://your-org.okta.com
# Read-only token for poll mode (okta.logs.read). Needs okta.users.manage only if AUTO_RESPONSE != none.
OKTA_API_TOKEN=
OKTA_AUTH_SCHEME=SSWS            # or Bearer for an OAuth service-app token
# Value Okta sends in the Authorization header of each Event Hook request
OKTA_EVENT_HOOK_SECRET=

# --- Claude triage ---
ANTHROPIC_API_KEY=
CLAUDE_TRIAGE=true
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# --- Detection tuning ---
TRIAGE_THRESHOLD=0.35            # heuristic score that sends an event to Claude
FLAG_THRESHOLD=0.6               # heuristic score that alerts when Claude is off/unavailable
WINDOW_SECONDS=900
ALLOWLIST=terraform@example.com,0oa_known_service_client   # sanctioned automation

# --- Alerting / response ---
SLACK_WEBHOOK_URL=
AUTO_RESPONSE=none               # none | clear_sessions | suspend
AUTO_RESPONSE_MIN_CONFIDENCE=0.9
